# ─────────────────────────────────────────────────────────
#  ELY BOT — Variables d'environnement
#  Copiez ce fichier en .env et remplissez les valeurs
# ─────────────────────────────────────────────────────────

# ── Propriétaire du bot ────────────────────────────────────
# Votre numéro WhatsApp avec l'indicatif pays (sans + ni espaces)
# Ex: 237697353272 pour le Cameroun (+237 6 97 35 32 72)
# Si vide → le bot détecte automatiquement le numéro de la session
OWNER_NUMBER=237697353272

# ── Code de jumelage (optionnel si QR code) ───────────────
PAIRING_NUMBER=

# ── IA : OpenRouter (GRATUIT) ─────────────────────────────
# Créez un compte sur https://openrouter.ai et générez une clé API
# Format : sk-or-v1-... — les modèles meta-llama/*:free sont gratuits
OPENROUTER_KEY=sk-or-v1-...

# ── IA : Google Gemini (GRATUIT) ──────────────────────────
# https://aistudio.google.com/app/apikey — jusqu'à 4 clés en rotation
GEMINI_KEY_1=AIza...
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=

# ── IA : WisdomGate (Optionnel) ────────────────────────────
WISDOM_GATE_KEY_1=
WISDOM_GATE_KEY_2=

# ── Session (hébergeurs éphémères : Render / Vercel) ───────
# Générez la valeur avec la commande .session (réservée au propriétaire)
# puis créez une variable d'environnement SESSION_DATA avec ce Base64.
SESSION_DATA=
SESSION_ID=session

# ── OpenAI (optionnel) ─────────────────────────────────────
OPENAI_API_KEY=

# ── Render Anti-Sleep (si hébergé sur Render) ─────────────
# URL de votre déploiement + clés API Render pour la persistance de session
RENDER_EXTERNAL_URL=https://votre-app.onrender.com
RENDER_API_KEY=
RENDER_SERVICE_ID=

# ── Débogage ──────────────────────────────────────────────
# DEBUG_ADMIN=1  → journalise la vérification admin à chaque commande en groupe
