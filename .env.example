# ─────────────────────────────────────────────────────────
#  ELY BOT — Variables d'environnement
#  Copiez ce fichier en .env et remplissez les valeurs
# ─────────────────────────────────────────────────────────

# ── Propriétaire du bot ────────────────────────────────────
# Votre numéro WhatsApp avec l'indicatif pays (sans + ni espaces)
# Ex: 237697353272 pour le Cameroun (+237 6 97 35 32 72)
# Si vide → le bot détecte automatiquement le numéro de la session
OWNER_NUMBER=237697353272

# ── Code de jumelage (optionnel si QR code) ───────────────
PAIRING_NUMBER=

# ── IA : OpenRouter / Meta Llama-3 (GRATUIT) ──────────────
# Créez un compte sur https://openrouter.ai et générez une clé API
# Format de la clé : sk-or-v1-...
# Les modèles meta-llama/*:free sont 100% gratuits
OPENROUTER_KEY=sk-or-v1-...

# ── IA : Google Gemini (GRATUIT) ──────────────────────────
# Créez vos clés sur https://aistudio.google.com/app/apikey
# Vous pouvez ajouter jusqu'à 4 clés pour la rotation automatique
GEMINI_KEY_1=AIza...
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=

# ── IA : WisdomGate (Optionnel) ────────────────────────────
WISDOM_GATE_KEY_1=
WISDOM_GATE_KEY_2=

# ── OpenAI / Session ───────────────────────────────────────
OPENAI_API_KEY=
SESSION_ID=session

# ── Render Anti-Sleep (si hébergé sur Render) ─────────────
# Remplacez par l'URL de votre déploiement Render
# RENDER_EXTERNAL_URL=https://votre-app.onrender.com
