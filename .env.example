# ─────────────────────────────────────────────────────────
#  ELY BOT — Environment Variables
#  Copiez ce fichier en .env et remplissez les valeurs
# ─────────────────────────────────────────────────────────

# Numéro de téléphone pour le code de jumelage (optionnel si QR code)
PAIRING_NUMBER=

# ── IA : OpenRouter / Meta Llama-3 (GRATUIT) ──────────────
# Créez un compte sur https://openrouter.ai et générez une clé API
# Les modèles meta-llama/*:free sont 100% gratuits
OPENROUTER_KEY=sk-or-v1-...

# ── IA : Google Gemini (GRATUIT) ──────────────────────────
# Créez vos clés sur https://aistudio.google.com/app/apikey
# Vous pouvez ajouter jusqu'à 4 clés pour la rotation automatique
GEMINI_KEY_1=AIza...
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=

# ── IA : WisdomGate (Optionnel) ────────────────────────────
WISDOM_GATE_KEY_1=
WISDOM_GATE_KEY_2=

# ── OpenAI / Session ───────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
SESSION_ID=session

# ── Render Anti-Sleep (si hébergé sur Render) ─────────────
# RENDER_EXTERNAL_URL=https://votre-app.onrender.com

# ── Vercel ────────────────────────────────────────────────
# Ces variables sont automatiquement injectées par Vercel :
# VERCEL=1, VERCEL_ENV=production/preview/development
